# all optional, unset var disables its feature
# VITE_ values inlined into public client bundle at build -> never secrets

# public PostHog phc_ key, unset disables analytics
VITE_POSTHOG_KEY=

# must stay on EU host, defaults to eu.i.posthog.com
VITE_POSTHOG_HOST=

# optional sendBeacon copy of events
VITE_TRACK_ENDPOINT=

# share text URL, defaults to window.location.origin
VITE_SHARE_URL=

# POST { email, source } endpoint behind app waitlist button
VITE_WAITLIST_ENDPOINT=

# GET ?level=<id> -> sampleSize + buckets of upToMs, count for chart band
VITE_STATS_ENDPOINT=
